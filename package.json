{
  "name": "press_money_sharp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "npx expo prebuild --platform android",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "prepare": "husky",
    "android:uat:apk": "cd android && ./gradlew assembleRelease",
    "android:dev:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@birdwingo/react-native-swipe-modal": "^1.2.5",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.13",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.80.6",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-query-persist-client": "^5.80.6",
    "add": "^2.0.6",
    "axios": "^1.9.0",
    "expo": "~56.0.18",
    "expo-clipboard": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-network": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-hook-form": "^7.56.4",
    "react-native": "0.85.3",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-image-viewing": "^0.2.2",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-phone-input": "^1.3.7",
    "react-native-reanimated": "4.3.1",
    "react-native-reanimated-carousel": "^4.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-version-check": "^3.5.0",
    "react-native-video": "^6.14.1",
    "react-native-worklets": "0.8.3",
    "yarn": "^1.22.22",
    "yup": "^1.6.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.33.0",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.2.14",
    "@types/react-native-version-check": "^3.4.8",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-phone-input",
          "@birdwingo/react-native-swipe-modal"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
